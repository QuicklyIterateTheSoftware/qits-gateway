<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>eu.wohlben</groupId>
    <artifactId>qits-gateway</artifactId>
    <version>2026.811.190126</version>
    <packaging>quarkus</packaging>

    <name>qits-gateway</name>
    <description>The qits front door: one origin that receives every inbound request and delegates
        it to the right qits component (the qits app, split-out siblings, workspace containers).
    </description>

    <!-- DELIBERATELY PARENT-LESS. qits-gateway lives in its own repository
         (github.com/wohlben/qits-gateway) and is consumed by the qits monorepo as a git submodule,
         but it is NOT a module of qits' Maven reactor: it is a separately deployable process with
         its own release cadence, and a clone of this repo alone must build. Versions that must stay
         in step with qits (the Quarkus platform, the JDK release) are duplicated here on purpose —
         see the compatibility note in README.md. -->

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <!-- Keep in step with the qits monorepo's quarkus.platform.version. -->
        <quarkus.platform.version>3.34.6</quarkus.platform.version>

        <!-- Quinoa is a Quarkiverse extension and is in NO BOM, so the version is pinned here. 2.8.2
             is the platform-wide choice (docs/project-setup-quinoa-angular.md in the qits monorepo):
             it is the last release built against a Quarkus OLDER than this repo's 3.34.6 (3.27.3
             LTS — the compatible direction), while 2.8.3 is built against 3.36.2, ahead of us. Bump
             it only when the platform's Quarkus passes the version a Quinoa release was built
             against, and bump it everywhere at once. -->
        <quinoa.version>2.8.2</quinoa.version>

        <compiler-plugin.version>3.15.0</compiler-plugin.version>
        <surefire-plugin.version>3.5.4</surefire-plugin.version>
        <enforcer-plugin.version>3.5.0</enforcer-plugin.version>
        <spotless-plugin.version>2.44.5</spotless-plugin.version>
        <google-java-format.version>1.28.0</google-java-format.version>
        <skipITs>true</skipITs>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- The dependency set is deliberately minimal, for the same reason workspace-daemon's is: this
         compiles to a GraalVM native binary, and every extension is image size, build time and
         reflection surface. NO REST layer, NO datasource, NO ORM — the gateway holds no state of its
         own; it reads a route table from config and streams bytes. -->
    <dependencies>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <!-- OTLP export to qits-observability. The extension is what instruments the process;
                 the endpoint and protocol in application.properties are what make it arrive, since
                 the defaults are gRPC to localhost:4317 and the receiver speaks HTTP/protobuf. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <!-- The HTTP server + the Vert.x `Router` the gateway registers its catch-all route on.
                 Raw Vert.x routes only (like qits' GitHostRoutes/ServiceProxyRoute) — a JAX-RS layer
                 would buy nothing for a component whose whole job is verbatim passthrough. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-vertx-http</artifactId>
        </dependency>
        <dependency>
            <!-- The reverse-proxy engine, same one qits' in-process ServiceProxyRoute uses: streams
                 request/response bodies without buffering them and forwards WebSocket upgrades by
                 default. Version managed by the platform BOM. -->
            <groupId>io.vertx</groupId>
            <artifactId>vertx-http-proxy</artifactId>
        </dependency>
        <dependency>
            <!-- Lets a deployment mount the route table as application.yaml instead of dotted
                 properties — a nested `qits.gateway.routes.<name>` tree is far easier to read and
                 review than one flat key per field. Properties/env keep working unchanged. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-config-yaml</artifactId>
        </dependency>
        <dependency>
            <!-- /q/health/{live,ready} for the container orchestrator. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-health</artifactId>
        </dependency>
        <dependency>
            <!-- The login itself. This is by far the largest thing this repo takes on, and it is
                 taken on HERE precisely so that nothing else has to: seven services would each have
                 needed the variant matrix, and each would have been independently mis-buildable.
                 One component chooses a scheme; the rest have no scheme to choose.

                 It stays on the classpath in the `local` target too — a single-module build cannot
                 conditionally drop a compile dependency, and @IfBuildProperty conditions the beans
                 rather than the jar. The cost is native-image size in a build that does not use it;
                 see README "Native image cost". -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-oidc</artifactId>
        </dependency>
        <dependency>
            <!-- The landing SPA. Quinoa takes the bundle in src/main/webui (the qits-spa-home
                 submodule) and registers it as build-time generated static resources, so the front
                 door serves a page instead of a 404 on every path no service claims.

                 It adds NO runtime machinery: the resources are baked into the binary at
                 augmentation and served by quarkus-vertx-http's own static-resource route. What it
                 does add is a BUILD-time step — see application.properties, where this build is
                 told to package an already-built bundle rather than to run a package manager
                 install, because the @qits packages the SPA depends on live only on the platform's
                 own registry and a docker build cannot reach it. -->
            <groupId>io.quarkiverse.quinoa</groupId>
            <artifactId>quarkus-quinoa</artifactId>
            <version>${quinoa.version}</version>
        </dependency>

        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- @TestSecurity: names the caller directly for the tests that are about routing and
                 header hygiene rather than about the login. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-test-security</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <extensions>true</extensions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler-plugin.version}</version>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <configuration>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <maven.home>${maven.home}</maven.home>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <configuration>
                            <excludes>
                                <exclude>**/GatewaySocketRoutingTest.java</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- The WebSocket routing tests, in a JVM of their own.

                             They need it, and the reason is worth writing down because it looks
                             like flakiness and is not: a WebSocket upgrade through
                             vertx-http-proxy only works on the FIRST Quarkus start in a JVM. Once
                             a @QuarkusTest with a different profile has forced a restart, the
                             upgrade silently degrades to a plain proxied GET — the upstream sees
                             an ordinary request and answers it, so the symptom is a handshake
                             failure with no error anywhere. Reproduced with the gateway's own
                             header work removed, so it is the harness rather than anything here;
                             a deployed gateway starts once and is unaffected.

                             A second surefire execution forks a second JVM, which is the whole
                             mechanism: in it, this class's application is the first start. -->
                        <id>websocket-tests</id>
                        <phase>test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>**/GatewaySocketRoutingTest.java</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                        <configuration>
                            <systemPropertyVariables>
                                <!-- Where @QuarkusIntegrationTest looks for the compiled binary in a
                                     `-Dnative` build. It is spelled `qits-gateway` and NOT
                                     ${project.build.finalName}-runner, because application.properties
                                     sets quarkus.package.output-name=qits-gateway with
                                     jar.add-runner-suffix=false — the -runner path does not exist and
                                     a native IT would launch nothing while the build stayed green.
                                     The name lives in two files; they move together. -->
                                <native.image.path>${project.build.directory}/qits-gateway</native.image.path>
                                <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                                <maven.home>${maven.home}</maven.home>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- Packaging the gateway requires naming an auth target explicitly. Bound to
                     prepare-package, not validate, on purpose: pre-packaging work — quarkus:dev,
                     test — runs flagless and defaults to oauth (see application.properties), and
                     only producing an artifact reaches this rule. A shipped gateway therefore
                     always said out loud whether it authenticates. -->
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>require-auth-variant</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireProperty>
                                    <property>qits.variant</property>
                                    <regex>oauth|local</regex>
                                    <message>Packaging qits-gateway requires an explicit auth target:
  -Dqits.variant=oauth   OIDC login terminated at the gateway; requires QUARKUS_OIDC_* env at runtime
  -Dqits.variant=local   EXPLICITLY UNAUTHENTICATED — every request is a fixed local user. Trusted LOCAL
                         starts only (a laptop run, a test rig). NEVER internet-expose.
(quarkus:dev and test default to oauth without the flag — a packaged build never defaults. The oauth
 target never degrades to `local`; only naming `local` produces an open build.)
See migration-auth-plan.md §5.</message>
                                    <regexMessage>Unknown qits.variant — valid values are: oauth, local.
See migration-auth-plan.md §5.</regexMessage>
                                </requireProperty>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- Same formatter as the qits monorepo (google-java-format, needs JDK 21+), applied
                     automatically on every build so formatting is never a review topic. -->
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless-plugin.version}</version>
                <configuration>
                    <java>
                        <googleJavaFormat>
                            <version>${google-java-format.version}</version>
                        </googleJavaFormat>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <id>spotless-apply</id>
                        <phase>process-sources</phase>
                        <goals>
                            <goal>apply</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- The `local` build target, EXPLICITLY UNAUTHENTICATED: every request is a fixed local
             user. For trusted local starts only — never internet-expose a local-target gateway.

             The @IfBuildProperty guards in security/ condition the *beans* on qits.auth.variant
             (see application.properties), but the OIDC *extension* has to be switched off too, and
             only at build time. quarkus-oidc treats a missing auth-server-url as a fatal
             misconfiguration, so a local gateway that still carried an enabled OIDC extension would
             refuse to start without an IdP it does not use — which is precisely the overhead this
             target exists to avoid. Verified by running the packaged artifact, not by reasoning.

             quarkus.oidc.enabled is read at augmentation, so this cannot be undone at runtime any
             more than the variant itself can. -->
        <profile>
            <id>variant-local</id>
            <activation>
                <property>
                    <name>qits.variant</name>
                    <value>local</value>
                </property>
            </activation>
            <properties>
                <quarkus.oidc.enabled>false</quarkus.oidc.enabled>
            </properties>
        </profile>

        <!-- GraalVM native build (mirrors qits' workspace-daemon): `-Dnative` disables the jar and
             enables the native image. There is no parent pom to inherit a native profile from, so it
             lives here.

             The toolchain is `.sdkmanrc`'s 25.0.2-graalce and nothing else: `sdk env` puts a
             native-image on JAVA_HOME and the compile runs in-process, no container. That has to be
             declared rather than assumed, because Quarkus does not fail when native-image is
             missing — it logs "Cannot find the native-image ... Attempting to fall back to container
             build" and shells docker with a 1.8 GB Mandrel image. Green either way, which is exactly
             how a repo ends up building under docker without anyone deciding to. The fallback stays
             working (it is what a GraalVM-less CI gets); it is just not the path this repo names.

             skipITs flips with the profile so a native build runs @QuarkusIntegrationTest against
             the binary rather than skipping past it — see failsafe's native.image.path above.

             docker/Dockerfile is the shipping form, not the build: it wraps this same binary in an
             image (with its own Mandrel builder, so a machine without a GraalVM can produce one). -->
        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <properties>
                <quarkus.package.jar.enabled>false</quarkus.package.jar.enabled>
                <skipITs>false</skipITs>
                <quarkus.native.enabled>true</quarkus.native.enabled>
            </properties>
        </profile>
    </profiles>
</project>
